# Supabase (cloud mode — required for web deploy)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe Payment Links — monthly (Coach / Coach Premium)
VITE_STRIPE_LINK_TEAM=https://buy.stripe.com/your-coach-monthly-link
VITE_STRIPE_LINK_CLUB=https://buy.stripe.com/your-coach-premium-monthly-link

# Stripe Payment Links — annual (2 months free: €490 / €890)
VITE_STRIPE_LINK_TEAM_ANNUAL=https://buy.stripe.com/your-coach-annual-link
VITE_STRIPE_LINK_CLUB_ANNUAL=https://buy.stripe.com/your-coach-premium-annual-link

# Team Academy is approval-only — do not set VITE_STRIPE_LINK_ORGANIZATION

# Stripe Customer Portal (optional — for subscription management)
VITE_STRIPE_BILLING_PORTAL_URL=https://billing.stripe.com/p/login/your-portal

# Dev only: allow demo subscription activation without Stripe (cloud)
# In production leave false and run supabase/fix-subscription-security.sql
VITE_DEMO_SUBSCRIPTION=false

# Optional price IDs for in-app plan switching (Stripe Dashboard → Products → Price ID)
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_CLUB=price_...
# STRIPE_PRICE_TEAM_ANNUAL=price_...
# STRIPE_PRICE_CLUB_ANNUAL=price_...

# Supabase Edge Function secrets (set via supabase secrets set — NOT in Vite)
# Deploy: supabase functions deploy stripe-webhook --no-verify-jwt
# Deploy: supabase functions deploy subscription-manage
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# STRIPE_PAYMENT_LINK_ID_TEAM=
# STRIPE_PAYMENT_LINK_ID_CLUB=
