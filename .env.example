# ─── Launch (manual billing) — required for cloud production ───
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Manual billing (initial launch): admin approval + payment confirmation
# Defaults to ON in cloud mode when Stripe links are not configured.
VITE_MANUAL_PAYMENTS=true

# Dev only — NEVER true in production
VITE_DEMO_SUBSCRIPTION=false

VITE_APP_URL=https://www.surfstar.app
VITE_CONTACT_EMAIL=contact@surfstar.app

# Legal entity (shown on Privacy Policy / Terms — set before launch)
VITE_LEGAL_ENTITY_NAME=SurfStar Lda
VITE_LEGAL_NIF=123456789
VITE_LEGAL_ADDRESS=Rua Example 1, 1000-001 Lisboa, Portugal
# VITE_COMPLAINTS_BOOK_URL=https://www.livroreclamacoes.pt/inicio

# Error monitoring (optional — only after cookie “Accept all”)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_DEBUG=false

# ─── Ops helpers (NOT Vite — local scripts / edge secrets) ───
# SUPABASE_SERVICE_ROLE_KEY=   # scripts/apply-manual-payment-details.mjs + ops:verify
# CRON_SECRET=                 # ops:verify --ping + edge function auth
# SURFSTAR_MANUAL_IBAN=PT50...
# SURFSTAR_MANUAL_MBWAY=+351...
# SURFSTAR_MANUAL_ACCOUNT_NAME=SurfStar

# Full checklist: LAUNCH_OPS.md
# npm run ops:verify

# ─── Stripe Payment Links — Phase 2 only (set VITE_MANUAL_PAYMENTS=false) ───
# VITE_STRIPE_LINK_TEAM=https://buy.stripe.com/your-coach-monthly-link
# VITE_STRIPE_LINK_CLUB=https://buy.stripe.com/your-coach-premium-monthly-link
# VITE_STRIPE_LINK_TEAM_ANNUAL=https://buy.stripe.com/your-coach-annual-link
# VITE_STRIPE_LINK_CLUB_ANNUAL=https://buy.stripe.com/your-coach-premium-annual-link
# Team Academy is approval-only — do not set VITE_STRIPE_LINK_ORGANIZATION
# VITE_STRIPE_BILLING_PORTAL_URL=https://billing.stripe.com/p/login/your-portal

# Optional price IDs for in-app plan switching (Stripe Dashboard → Products → Price ID)
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_CLUB=price_...
# STRIPE_PRICE_TEAM_ANNUAL=price_...
# STRIPE_PRICE_CLUB_ANNUAL=price_...

# Supabase Edge Function secrets (supabase secrets set — NOT in Vite)
# Deploy (launch): admin-notify, coach-notify, subscription-renewal-cron
# Deploy (Phase 2): stripe-webhook, subscription-manage
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# STRIPE_PAYMENT_LINK_ID_TEAM=
# STRIPE_PAYMENT_LINK_ID_CLUB=
# SMTP_HOST=smtp-pt.securemail.pro
# SMTP_PORT=465
# SMTP_USER=contact@surfstar.app
# SMTP_PASSWORD=
# SMTP_FROM=contact@surfstar.app
# SMTP_FROM_NAME=SurfStar
# COACH_NOTIFY_BCC=contact@surfstar.app,armindoapp@outlook.com
